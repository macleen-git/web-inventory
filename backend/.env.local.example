# LOCAL DEVELOPMENT ONLY — XAMPP / MariaDB
# Copy this file to backend/.env for local development.
# These values connect ONLY to hardware_inventory_local on this computer.
PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hardware_inventory_local
DB_SSL=false

# Keep the same Firebase project as the online app.
# Configure ONE Firebase Admin credential method locally.
# Option A: path to a service-account JSON file outside Git:
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/firebase-service-account.json
# Option B: paste the complete service-account JSON into this environment variable
# (do not commit backend/.env or any service-account JSON).
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Allow the local Vite frontend to call this backend.
CORS_ORIGIN=http://localhost:5173
