# Express API
PORT=8080

# PRIMARY DATABASE: Aiven Cloud MySQL
# Use the existing Aiven service/database so localhost and the deployed app share data.
DB_HOST=mysql-240c9419-hardware-inventory.b.aivencloud.com
DB_PORT=27706
DB_USER=YOUR_AIVEN_USERNAME
DB_PASSWORD=YOUR_AIVEN_PASSWORD
DB_NAME=defaultdb
DB_SSL=true
DB_SSL_CA=./certs/ca.pem

# Download the CA certificate from the Aiven console and save it as:
# backend/certs/ca.pem
# Keep backend/.env and backend/certs/ca.pem out of Git.

# Optional: comma-separated frontend origins
# CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK (required for the database-backed admin dashboard)
# Set this to the complete service-account JSON for the same Firebase project.
# Keep the private key secret; never commit it or paste it into source code.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional local XAMPP alternative (only if you intentionally want a separate local DB):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=hardware_inventory_v2
# DB_SSL=false
