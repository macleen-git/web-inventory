# Express API
PORT=8080

# XAMPP local MariaDB/MySQL defaults (use these for local database testing)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hardware_inventory_v2
DB_SSL=false

# Aiven Cloud MySQL: replace the values above with your Aiven service details.
# Download the Aiven CA certificate and save it at backend/certs/ca.pem.
# Then use these settings (do not commit backend/.env or the certificate).
# DB_HOST=your-aiven-host
# DB_PORT=your-aiven-port
# DB_USER=your-aiven-username
# DB_PASSWORD=your-aiven-password
# DB_NAME=hardware_inventory_v2
# DB_SSL=true
# DB_SSL_CA=./certs/ca.pem

# Optional: comma-separated frontend origins
# CORS_ORIGIN=http://localhost:5173
